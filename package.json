{
  "name": "keycloak-api-ts",
  "version": "1.0.0",
  "description": "A Keycloak admin API client.",
  "author": "Edmilson Santana <42233304+edmilsonss@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Master-Mils/keycloak-api-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Master-Mils/keycloak-api-ts/issues"
  },
  "homepage": "https://github.com/Master-Mils/keycloak-api-ts#readme",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint .",
    "test": "mocha \"test/unit/**/*.test.ts\"",
    "test:integration": "mocha --timeout 180000 \"test/integration/**/*.test.ts\"",
    "gen:types": "tsx scripts/generate-types.ts",
    "publish:patch": "npm run build && npm version patch --force && npm publish && git push",
    "publish:minor": "npm run build && npm version minor --force && npm publish && git push",
    "publish:major": "npm run build && npm version major --force && npm publish && git push",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A lib"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "chai": "^6.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "nock": "^14.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "testcontainers": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "keycloak",
    "api",
    "admin",
    "oauth",
    "oidc"
  ]
}
