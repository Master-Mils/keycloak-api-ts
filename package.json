{
  "name": "keycloak-api-ts",
  "version": "2.0.0",
  "description": "TypeScript client for the Keycloak Admin REST API: 100% of the endpoints, generated types, errors as values and automatic token renewal. Keycloak 24, 25 and 26; CommonJS and ESM.",
  "author": "Edmilson Santana <42233304+edmilsonss@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Master-Mils/keycloak-api-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Master-Mils/keycloak-api-ts/issues"
  },
  "homepage": "https://github.com/Master-Mils/keycloak-api-ts#readme",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\"",
    "lint": "eslint .",
    "test": "mocha \"test/unit/**/*.test.ts\"",
    "test:integration": "mocha --timeout 360000 \"test/integration/**/*.test.ts\"",
    "gen:types": "tsx tools/generate-types.ts",
    "publish:patch": "npm run build && npm version patch --force && npm publish && git push",
    "publish:minor": "npm run build && npm version minor --force && npm publish && git push",
    "publish:major": "npm run build && npm version major --force && npm publish && git push",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A lib"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "nock": "^15.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "keycloak",
    "keycloak-admin",
    "keycloak-admin-client",
    "keycloak-api",
    "keycloak-rest-api",
    "keycloak-client",
    "admin-api",
    "rest-api",
    "api-client",
    "sdk",
    "typescript",
    "nodejs",
    "iam",
    "identity",
    "sso",
    "oauth2",
    "openid-connect",
    "oidc",
    "authentication",
    "authorization",
    "user-management",
    "realm"
  ]
}
